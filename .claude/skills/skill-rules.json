{
    "version": "1.0",
    "description": "Skill activation triggers for Unity 6.3 LTS development. Controls when skills automatically suggest or block actions.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "skill system",
                    "create skill",
                    "add skill",
                    "skill triggers",
                    "skill rules",
                    "hook system",
                    "skill development",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(how do|how does|explain).*?skill",
                    "(create|add|modify|build).*?skill",
                    "skill.*?(work|trigger|activate|system)"
                ]
            }
        },
        "unity-gameplay-patterns": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Unity gameplay programming patterns for MonoBehaviour, ScriptableObjects, and game systems",
            "promptTriggers": {
                "keywords": [
                    "MonoBehaviour",
                    "GameObject",
                    "component",
                    "coroutine",
                    "ScriptableObject",
                    "gameplay",
                    "game mechanic",
                    "player controller",
                    "enemy AI",
                    "state machine",
                    "object pool",
                    "service locator",
                    "design pattern",
                    "event system",
                    "UnityEvent",
                    "async",
                    "await",
                    "Awake",
                    "Start",
                    "Update",
                    "FixedUpdate"
                ],
                "intentPatterns": [
                    "(create|add|implement|build).*?(gameplay|mechanic|system|controller)",
                    "(fix|debug).*?(MonoBehaviour|component|coroutine)",
                    "(optimize|improve).*?(performance|Update|FixedUpdate)",
                    "(add|implement).*?(event|observer|pattern)",
                    "(how to|best practice).*?(MonoBehaviour|ScriptableObject|component)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "Assets/Scripts/**/*.cs",
                    "Assets/**/Scripts/**/*.cs",
                    "Assets/_Project/Scripts/**/*.cs",
                    "Assets/Core/**/*.cs",
                    "Assets/Gameplay/**/*.cs"
                ],
                "pathExclusions": [
                    "**/Editor/**/*.cs",
                    "**/*.Editor.cs",
                    "**/Tests/**/*.cs",
                    "**/*.Tests.cs"
                ],
                "contentPatterns": [
                    "class.*MonoBehaviour",
                    "class.*ScriptableObject",
                    "IEnumerator",
                    "async.*Task",
                    "void.*Awake\\(",
                    "void.*Start\\(",
                    "void.*Update\\(",
                    "void.*FixedUpdate\\("
                ]
            }
        },
        "unity-ui-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Unity UI development with UI Toolkit and UGUI for Unity 6.3 LTS",
            "promptTriggers": {
                "keywords": [
                    "UI Toolkit",
                    "UXML",
                    "USS",
                    "VisualElement",
                    "UIDocument",
                    "UI",
                    "menu",
                    "HUD",
                    "dialog",
                    "Canvas",
                    "UGUI",
                    "RectTransform",
                    "Button",
                    "Label",
                    "TextField",
                    "Slider",
                    "UI Builder"
                ],
                "intentPatterns": [
                    "(create|add|make|build).*?(UI|menu|dialog|HUD|interface)",
                    "(style|design).*?(UI|button|panel)",
                    "(fix|debug).*?(UI|Canvas|UIDocument)",
                    "(how to|best practice).*?(UI Toolkit|UXML|USS|Canvas)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "Assets/**/UI/**/*.cs",
                    "Assets/**/Menus/**/*.cs",
                    "Assets/**/*.uxml",
                    "Assets/**/*.uss",
                    "Assets/UI/**/*"
                ],
                "contentPatterns": [
                    "using UnityEngine.UIElements",
                    "UIDocument",
                    "VisualElement",
                    "UXML",
                    "USS",
                    "Canvas",
                    "RectTransform",
                    "Button.*clicked"
                ]
            }
        },
        "unity-editor-tools": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Unity Editor extensions, custom inspectors, and tools",
            "promptTriggers": {
                "keywords": [
                    "CustomEditor",
                    "Editor",
                    "PropertyDrawer",
                    "EditorWindow",
                    "MenuItem",
                    "custom inspector",
                    "editor window",
                    "editor tool",
                    "Gizmos",
                    "Handles",
                    "ScriptedImporter",
                    "AssetPostprocessor",
                    "BuildPlayer"
                ],
                "intentPatterns": [
                    "(create|add|build).*?(editor|inspector|tool|window)",
                    "(customize|extend).*?(editor|inspector|import)",
                    "(draw|visualize).*?(Gizmo|Handle|scene)",
                    "(how to|best practice).*?(editor|CustomEditor|PropertyDrawer)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "Assets/**/Editor/**/*.cs",
                    "Assets/**/*.Editor.cs",
                    "Editor/**/*.cs"
                ],
                "contentPatterns": [
                    "\\[CustomEditor\\(",
                    "\\[CustomPropertyDrawer\\(",
                    "EditorWindow",
                    "\\[MenuItem\\(",
                    "OnInspectorGUI",
                    "OnSceneGUI",
                    "DrawGizmo",
                    "using UnityEditor"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        },
        "customization": {
            "pathPatterns": "Adjust to match your Unity project structure (Assets/Scripts, Assets/_Project, etc.)",
            "keywords": "Add project-specific terms (custom systems, naming conventions)",
            "intentPatterns": "Use regex for flexible user intent matching",
            "contentPatterns": "Match Unity-specific code patterns (MonoBehaviour, CustomEditor, etc.)"
        }
    }
}
