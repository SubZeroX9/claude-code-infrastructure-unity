{
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "sequential-thinking"
  ],
  "permissions": {
    "allow": [
      "Edit:*",
      "Write:*",
      "MultiEdit:*",
      "NotebookEdit:*",
      "Bash:*"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/skill-activation-prompt.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use-tracker.sh"
          }
        ]
      }
    ],
    "Stop": []
  },
  "_comment": "Stop hooks explicitly set to empty array to override any global settings. The hooks above require bash (Git Bash, WSL, or Unix). On Windows without bash, you may need to disable hooks or convert them to .bat/.ps1 files."
}
